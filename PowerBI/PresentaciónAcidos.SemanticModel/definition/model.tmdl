model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CO
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Sustancias","Pasos","Reacciones","Solventes"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Sustancias
ref table Reacciones
ref table Solventes

ref cultureInfo es-ES

