expression Pasos =
		let
		    Origen = let
		    Origen = Excel.Workbook(File.Contents("C:\Users\Lorena\Downloads\Plantilla_Documento_LaTex (1)\PowerBI_Acidos\tabla_acidos.xlsx"), null, true),
		    R0 = Origen{[Item = "T_Reacciones", Kind = "Table"]}[Data],
		    O0 = Origen{[Item = "T_Obtenciones", Kind = "Table"]}[Data],
		    R1 = Table.RenameColumns(R0, {{"Producto", "Compuesto"}, {"CAS producto", "CAS compuesto"}}),
		    O1 = Table.RenameColumns(O0, {{"Reactante principal", "Compuesto"}, {"CAS reactante", "CAS compuesto"}}),
		    R2 = Table.AddColumn(R1, "Conjunto", each "Reacciones", type text),
		    O2 = Table.AddColumn(O1, "Conjunto", each "Obtenciones", type text),
		    Unidas = Table.Combine({R2, O2}),
		    SinNA = Table.ReplaceValue(Unidas, "NA", null, Replacer.ReplaceValue, Table.ColumnNames(Unidas)),
		    Tipos = Table.TransformColumnTypes(SinNA, {
		        {"Paso", Int64.Type},
		        {"PM (g/mol)", type number}, {"Pf (°C)", type number}, {"Peb (°C)", type number},
		        {"ρ (g/cm³)", type number}, {"pKa", type number}, {"μ (D)", type number},
		        {"Solubilidad (mol/L)", type number}, {"Pv (Pa)", type number},
		        {"T (°C)", type number}, {"t (h)", type number}, {"P (bar)", type number}})
		in
		    Tipos
		in
		    Origen
	lineageTag: c5715cfd-e6bb-4ebb-b258-d02bd7747957

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

