table Reacciones
	lineageTag: 39807e6a-d149-410b-9c83-c604c8523062

	measure 'N reacciones' = COUNTROWS ( Reacciones )
		formatString: 0
		lineageTag: 4bb1cfe3-a06c-447c-87b7-ebb69d3b2e9c

	measure 'N con temperatura' = CALCULATE ( [N reacciones], NOT ISBLANK ( Reacciones[T máx (°C)] ) )
		formatString: 0
		lineageTag: a1361a7d-1245-4129-99cc-4f8425c92c05

	measure 'N con calor' = CALCULATE ( [N reacciones], Reacciones[T máx (°C)] > 25 )
		formatString: 0
		lineageTag: 6d9d162a-a313-4bc3-8228-bcf0d78cdb6d

	measure 'P calentamiento' = DIVIDE ( [N con calor], [N con temperatura] )
		formatString: 0.00
		lineageTag: 6cd39c55-6793-4c96-8279-00015144737b

	measure 'Mediana T (°C)' = MEDIAN ( Reacciones[T máx (°C)] )
		formatString: 0.0
		lineageTag: 95d1ac8a-b213-4d36-a8ef-892933a28460

	measure 'P catalizador' = DIVIDE ( CALCULATE ( [N reacciones], Reacciones[Usa catalizador] = "Sí" ), [N reacciones] )
		formatString: 0.00
		lineageTag: bf205657-343d-48dd-9ea9-4c00413b0eac

	measure 'P tipo de reacción' = DIVIDE ( [N reacciones], CALCULATE ( [N reacciones], REMOVEFILTERS ( Reacciones[Tipo de reacción] ) ) )
		formatString: 0.00
		lineageTag: 18ef43a4-2d58-4cd8-a7d6-5722c9a61b44

	measure 'P medio' = DIVIDE ( [N reacciones], CALCULATE ( [N reacciones], REMOVEFILTERS ( Reacciones[Medio] ), NOT ISBLANK ( Reacciones[Medio] ) ) )
		formatString: 0.00
		lineageTag: ceccf53d-4f0a-4a21-bb3a-11f43a01f864

	measure 'N con medio' = CALCULATE ( [N reacciones], REMOVEFILTERS ( Reacciones[Medio] ), NOT ISBLANK ( Reacciones[Medio] ) )
		formatString: 0
		lineageTag: 394451b9-f3df-40ac-8595-d1b60dd69156

	measure 'P medio IC inferior' = VAR n = [N con medio] VAR p = [P medio] VAR z = 1.96 VAR centro = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n ) VAR ancho = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n ) RETURN IF ( n > 0, centro - ancho )
		formatString: 0.00
		lineageTag: 60fb6b5b-8ca2-4da6-9521-dc4da4eb40c5

	measure 'P medio IC superior' = VAR n = [N con medio] VAR p = [P medio] VAR z = 1.96 VAR centro = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n ) VAR ancho = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n ) RETURN IF ( n > 0, centro + ancho )
		formatString: 0.00
		lineageTag: e5b3fa9b-dec4-4258-951c-556f81506177

	measure 'P calentamiento IC inferior' = VAR n = [N con temperatura] VAR p = [P calentamiento] VAR z = 1.96 VAR centro = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n ) VAR ancho = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n ) RETURN IF ( n > 0, centro - ancho )
		formatString: 0.00
		lineageTag: 1cacb44a-b624-415f-b574-8ce901390c9d

	measure 'P calentamiento IC superior' = VAR n = [N con temperatura] VAR p = [P calentamiento] VAR z = 1.96 VAR centro = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n ) VAR ancho = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n ) RETURN IF ( n > 0, centro + ancho )
		formatString: 0.00
		lineageTag: 630ce870-6fbc-461c-862f-74b06bebe10d

	measure 'r Pearson PM-Peb' = VAR t = FILTER ( Reacciones, NOT ISBLANK ( Reacciones[PM (g/mol)] ) && NOT ISBLANK ( Reacciones[Peb (°C)] ) ) VAR mx = AVERAGEX ( t, Reacciones[PM (g/mol)] ) VAR my = AVERAGEX ( t, Reacciones[Peb (°C)] ) VAR sxy = SUMX ( t, ( Reacciones[PM (g/mol)] - mx ) * ( Reacciones[Peb (°C)] - my ) ) VAR sxx = SUMX ( t, ( Reacciones[PM (g/mol)] - mx ) ^ 2 ) VAR syy = SUMX ( t, ( Reacciones[Peb (°C)] - my ) ^ 2 ) RETURN DIVIDE ( sxy, SQRT ( sxx * syy ) )
		formatString: 0.00
		lineageTag: 8cc23309-298f-4c4c-a735-1f261b833b29

	measure 'R2 PM-Peb' = [r Pearson PM-Peb] ^ 2
		formatString: 0.00
		lineageTag: 54473f75-96a7-4b73-a9d3-c2d17c5d574f

	measure 'N solventes' = COUNTROWS ( Solventes )
		formatString: 0
		lineageTag: 4368113a-10b9-4a31-afe0-9a1b5c6d68bd

	measure 'P histograma T' = DIVIDE ( [N reacciones], CALCULATE ( [N con temperatura], REMOVEFILTERS ( Reacciones[Intervalo T (°C)] ) ) )
		formatString: 0.00
		lineageTag: d7743e03-34a3-46cb-83e9-85a097b0cae0

	measure 'N reacciones (conjunto)' = CALCULATE ( [N reacciones], Reacciones[Conjunto] = "Reacciones" )
		formatString: 0
		lineageTag: 96d9acd1-5fc1-4bff-8c6d-5efbdc0c506f

	measure 'N obtenciones' = CALCULATE ( [N reacciones], Reacciones[Conjunto] = "Obtenciones" )
		formatString: 0
		lineageTag: 5c5be692-2e1e-40fe-8b42-5a76f132b2a3

