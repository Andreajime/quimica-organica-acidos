		summarizeBy: none

	column 'Intervalo T (°C)' = IF ( NOT ISBLANK ( Reacciones[T máx (°C)] ), FLOOR ( Reacciones[T máx (°C)], 25 ) )
		dataType: double
		formatString: 0
		lineageTag: 3d20458e-de41-4cfe-b31a-5b1493541222
		summarizeBy: none

	partition Reacciones = m
		mode: import
		source =
				let
				    Origen = let
				    Origen = Pasos,
				    Paso1 = Table.SelectRows(Origen, each [Paso] = 1),
				    Quitar = Table.SelectColumns(Paso1, {"ID", "Sustancia", "Conjunto", "Compuesto", "CAS compuesto",
				        "PM (g/mol)", "Pf (°C)", "Peb (°C)", "ρ (g/cm³)", "pKa", "μ (D)", "Solubilidad (mol/L)", "Pv (Pa)",
				        "Medio", "Tipo de reacción", "Nombre de la reacción"}),
				    PorReaccion = Table.Group(Origen, {"ID"}, {
				        {"T máx (°C)", each List.Max([#"T (°C)"]), type nullable number},
				        {"Número de pasos", each Table.RowCount(_), Int64.Type},
				        {"Usa catalizador", each if List.NonNullCount([Catalizador 1]) > 0 then "Sí" else "No", type text}}),
				    Unir = Table.NestedJoin(Quitar, {"ID"}, PorReaccion, {"ID"}, "Datos", JoinKind.LeftOuter),
				    Expandir = Table.ExpandTableColumn(Unir, "Datos", {"T máx (°C)", "Número de pasos", "Usa catalizador"}),
				    Calor = Table.AddColumn(Expandir, "Calentamiento",
				        each if [#"T máx (°C)"] = null then null else if [#"T máx (°C)"] > 25 then "Sí" else "No", type text)
				in
				    Calor
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

