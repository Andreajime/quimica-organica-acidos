	partition Sustancias = m
		mode: import
		source =
				let
				    Origen = let
				    Origen = Excel.Workbook(File.Contents("C:\Users\Lorena\Downloads\Plantilla_Documento_LaTex (1)\PowerBI_Acidos\tabla_acidos.xlsx"), null, true),
				    Tabla = Origen{[Item = "T_Sustancias", Kind = "Table"]}[Data],
				    SinNA = Table.ReplaceValue(Tabla, "NA", null, Replacer.ReplaceValue, Table.ColumnNames(Tabla)),
				    Tipos = Table.TransformColumnTypes(SinNA, {
				        {"Sustancia", type text}, {"CAS", type text},
				        {"PM (g/mol)", type number}, {"Pf (°C)", type number}, {"Peb (°C)", type number},
				        {"ρ (g/cm³)", type number}, {"pKa", type number}, {"μ (D)", type number},
				        {"Solubilidad (mol/L)", type number}, {"Pv (Pa)", type number}}),
				    Nombre = Table.AddColumn(Tipos, "Nombre corto",
				        each Text.Proper(Text.Replace([Sustancia], "Ácido ", "")), type text)
				in
				    Nombre
				in
				    Origen

